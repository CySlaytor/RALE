/* Modern Dark Theme following PointerFinder2 Design Blueprint */

/* Base font for closed QComboBox and general UI */
QWidget {
    font-family: "Segoe UI", "Inter", "Helvetica Neue", sans-serif;
}

QMainWindow, QDialog {
    background-color: #202020;
    color: #ffffff;
}

/* Tables in Dark Mode */
QTableView, QTableWidget {
    background-color: #202022;
    color: #f0f0f0;
    border: 1px solid #38383c;
    gridline-color: #2e2e32;
    selection-background-color: #0078d7;
    selection-color: #ffffff;
    outline: 0;
}

QDialog QTableView, QDialog QTableWidget {
    background-color: #202022;
    color: #f0f0f0;
    border: 1px solid #38383c;
    gridline-color: #2e2e32;
    selection-background-color: #0078d7;
    selection-color: #ffffff;
    outline: 0;
}

/* MultiRegionDialog tables maintain consistent #242428 workspace background when empty */
#dgvMapping, #gridLockLogic {
    background-color: #202022;
    gridline-color: #38383c;
}

QTreeWidget, QListWidget {
    background-color: #202022;
    color: #f0f0f0;
    border: 1px solid #38383c;
    gridline-color: #2e2e32;
    selection-background-color: #0078d7;
    selection-color: #ffffff;
    outline: 0;
}

QTreeWidget::item, QListWidget::item {
    min-height: 18px;
}

#lblStrideHint, #lblHint, #lblInstruction, #lblInfo {
    color: #8a8a8a;
}

QHeaderView::section {
    background-color: #202022;
    color: #f0f0f0;
    border: 1px solid #38383c;
    border-top: none;
    border-left: none;
    padding: 3px 5px;
    font-weight: normal;
    text-align: left;
}
QHeaderView::section:checked, QHeaderView::section:selected {
    background-color: #38383c;
    color: #ffffff;
    border: 1px solid #38383c;
    border-top: none;
    border-left: none;
}
QTableView QTableCornerButton::section {
    background-color: #202022;
    border: 1px solid #38383c;
}

#lblGroupsHeader {
    background-color: #202022;
    border: 1px solid #38383c;
    color: #f0f0f0;
}

QLineEdit, QPlainTextEdit, QTextEdit {
    border: 1px solid #3f3f46;
    border-radius: 2px;
    background-color: #1b1b1c;
    color: #f0f0f0;
    padding: 2px 3px;
    selection-background-color: #0078d7;
}
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus {
    border-color: #0078d7;
}

QPushButton {
    border: 1px solid #434346;
    border-radius: 2px;
    background-color: #2d2d30;
    color: #f0f0f0;
    padding: 0px 4px 2px 4px;
    min-height: 16px;
    text-align: center;
}
QPushButton:hover {
    background-color: #3e3e42;
    border-color: #0078d7;
}
QPushButton:pressed {
    background-color: #0078d7;
    border-color: #0078d7;
}
QPushButton:disabled {
    background-color: #202022;
    color: #656565;
    border-color: #38383c;
}

/* Dedicated clean styling for the Groups + / - buttons */
#btnAddGroup, #btnRemoveGroup {
    background-color: #2d2d30;
    border: 1px solid #434346;
    border-radius: 3px;
    color: #f0f0f0;
    font-size: 9pt;
    font-weight: bold;
    padding: 0px 0px 2px 0px;
    min-height: 18px;
    min-width: 20px;
}
#btnAddGroup:hover, #btnRemoveGroup:hover {
    background-color: #3e3e42;
    border-color: #0078d7;
}
#btnAddGroup:pressed, #btnRemoveGroup:pressed {
    background-color: #0078d7;
    border-color: #0078d7;
}

/* Dropdown Popup View (applies to every QComboBox popup) */
QComboBox QListView,
QListView#comboPopupView {
    background-color: #1a1a1a;
    color: #ffffff;
    border: 1px solid #383838;
    padding: 1px;
    outline: 0;
    font-family: "Consolas", "Segoe UI", monospace;
    font-size: 11px;
}

QComboBox QListView::item,
QListView#comboPopupView::item {
    height: 19px;
    min-height: 19px;
    padding: 1px 4px;
}

QComboBox QListView::item:hover,
QListView#comboPopupView::item:hover {
    background-color: #2c2c2c;
}

QComboBox QListView::item:selected,
QListView#comboPopupView::item:selected {
    background-color: #3b4252;
    color: #ffffff;
}

/* Checkboxes base layout */
QCheckBox {
    spacing: 5px;
    color: #f0f0f0;
    background: transparent;
}
QCheckBox::indicator,
QAbstractItemView::indicator,
QTreeWidget::indicator,
QListWidget::indicator,
QTableView::indicator,
QTableWidget::indicator {
    width: 13px;
    height: 13px;
}

QSplitter::handle {
    background-color: #38383c;
}
QSplitter::handle:hover {
    background-color: #0078d7;
}
QSplitter::handle:horizontal {
    width: 2px;
}
QSplitter::handle:vertical {
    height: 2px;
}

/* Slim Scrollbars inside dropdowns and views */
QScrollBar:vertical {
    border: none;
    background-color: #141414;
    width: 8px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background-color: #3e3e3e;
    min-height: 20px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background-color: #4e4e4e;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background-color: #141414;
    height: 8px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background-color: #3e3e3e;
    min-width: 20px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #4e4e4e;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

QStatusBar {
    background-color: #202022;
    color: #f0f0f0;
    border-top: 1px solid #38383c;
    min-height: 22px;
    max-height: 22px;
}
