/* Modern Dark Theme following PointerFinder2 Design Blueprint */

/* Base font for closed QComboBox and general UI */
QWidget {
    font-family: "Segoe UI", "Inter", "Helvetica Neue", sans-serif;
}

QMainWindow {
    background-color: #202020;
    color: #ffffff;
}

QDialog {
    background-color: #1f1f1f;
    color: #ffffff;
}

/* Tooltips */
QToolTip {
    background-color: #202020;
    color: #f0f0f0;
    border: 1px solid #3a3a3a;
    border-radius: 3px;
    padding: 2px 4px;
    font-size: 11px;
    margin: 0px;
}

/* QTabWidget Pane & Styling matching Pointer Finder 2.0 Settings */
QTabWidget::pane {
    border: 1px solid #323232;
    background-color: #1f1f1f;
    top: -1px;
}
QTabWidget::tab-bar {
    left: 4px;
}
QTabBar::tab {
    background-color: #292929;
    color: #b0b0b0;
    border: 1px solid #323232;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 5px 12px;
    margin-right: 2px;
    font-size: 11px;
}
QTabBar::tab:hover {
    background-color: #353535;
    color: #ffffff;
}
QTabBar::tab:selected {
    background-color: #1f1f1f;
    color: #ffffff;
    border-bottom: 1px solid #1f1f1f;
    font-weight: bold;
}

/* Group Boxes matching Pointer Finder 2.0 */
QGroupBox {
    border: 1px solid #323232;
    border-radius: 4px;
    margin-top: 8px;
    font-size: 11px;
    font-weight: bold;
    color: #a0a0a0;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 3px;
}

/* Tables in Dark Mode */
QTableView, QTableWidget {
    background-color: #202022;
    color: #f0f0f0;
    border: 1px solid #38383c;
    gridline-color: #2e2e32;
    selection-background-color: #0078d7;
    selection-color: #ffffff;
    outline: 0;
}

QDialog QTableView, QDialog QTableWidget {
    background-color: #202022;
    color: #f0f0f0;
    border: 1px solid #38383c;
    gridline-color: #2e2e32;
    selection-background-color: #0078d7;
    selection-color: #ffffff;
    outline: 0;
}

/* MultiRegionDialog tables maintain consistent #242428 workspace background when empty */
#dgvMapping, #gridLockLogic {
    background-color: #202022;
    gridline-color: #38383c;
}

QTreeWidget, QListWidget {
    background-color: #202022;
    color: #f0f0f0;
    border: 1px solid #38383c;
    gridline-color: #2e2e32;
    selection-background-color: #0078d7;
    selection-color: #ffffff;
    outline: 0;
}

QTreeWidget::item, QListWidget::item {
    min-height: 18px;
}

#groupsList {
    border-top: none;
    padding-top: 2px;
}

#groupsList::item {
    min-height: 20px;
    padding: 1px 2px;
}

#lblStrideHint, #lblHint, #lblInstruction, #lblInfo {
    color: #8a8a8a;
}

#lblOffsetChain, #lblAuthor {
    color: #a0a0a0;
}

#lblAssetState {
    color: #a0a0a0;
    font-style: italic;
}

#lblAssetState[assetState="local"] {
    color: #3fb950;
    font-style: italic;
}

#pbBadge {
    border: 1px solid #38383c;
    background-color: #2a2a2e;
}

QLabel#strideHexLabel {
    color: #58a6ff;
    font-weight: bold;
    font-family: "Consolas", monospace;
}

QLabel#subTextDescLabel {
    color: #8b949e;
    font-size: 11px;
}

QLabel#settingsHelpTitleLabel {
    font-size: 13px;
    font-weight: bold;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #202022;
    color: #f0f0f0;
    border: 1px solid #38383c;
    border-top: none;
    border-left: none;
    padding: 3px 5px;
    font-weight: normal;
    text-align: left;
}
QHeaderView::section:checked, QHeaderView::section:selected {
    background-color: #38383c;
    color: #ffffff;
    border: 1px solid #38383c;
    border-top: none;
    border-left: none;
}
QTableView QTableCornerButton::section {
    background-color: #202022;
    border: 1px solid #38383c;
}

#lblGroupsHeader {
    background-color: #202022;
    border: 1px solid #38383c;
    color: #f0f0f0;
}

QLineEdit {
    border: 1px solid #3f3f46;
    border-radius: 2px;
    background-color: #1b1b1c;
    color: #f0f0f0;
    padding: 2px 3px;
    selection-background-color: #0078d7;
}
QLineEdit:focus {
    border-color: #0078d7;
}
QLineEdit[feedbackState="fail"] {
    background-color: #3a1d1d;
    border-color: #e5534b;
}
QLineEdit[feedbackState="warn"] {
    background-color: #36301a;
    border-color: #d29922;
}
QLineEdit[feedbackState="info"] {
    background-color: #1b2a3a;
    border-color: #58a6ff;
}

QDialog QLineEdit {
    background-color: #141414;
    color: #ffffff;
    border: 1px solid #323232;
    border-radius: 3px;
    padding: 3px 5px;
    font-size: 11px;
}
QDialog QLineEdit:focus {
    border-color: #3a78cb;
}

QPlainTextEdit, QTextEdit {
    font-family: "Consolas", "JetBrains Mono", "Courier New", monospace;
    font-size: 11px;
    background-color: #1a1a1a;
    color: #ffffff;
    border: 1px solid #323232;
    border-radius: 3px;
}
QPlainTextEdit:focus, QTextEdit:focus {
    border-color: #3a78cb;
}

#txtNoteBody {
    font-family: "Consolas", "Courier New", monospace;
    font-size: 10pt;
}

QPushButton {
    border: 1px solid #434346;
    border-radius: 2px;
    background-color: #2d2d30;
    color: #f0f0f0;
    padding: 0px 4px 2px 4px;
    min-height: 16px;
    text-align: center;
}
QPushButton:hover {
    background-color: #3e3e42;
    border-color: #0078d7;
}
QPushButton:pressed {
    background-color: #0078d7;
    border-color: #0078d7;
}
QPushButton:disabled {
    background-color: #202022;
    color: #656565;
    border-color: #38383c;
}

/* Dedicated compact button sizing matching PF2 */
QPushButton#okButton,
QPushButton#cancelButton,
QPushButton#closeButton {
    min-width: 56px;
    max-width: 56px;
    height: 17px;
    padding: 2px 8px;
    font-size: 11px;
}

QPushButton#updateNowButton {
    font-weight: bold;
    padding: 2px 12px;
}

QPushButton#resetAllButton {
    color: #ff5555;
    font-weight: bold;
    padding: 4px;
    border: 1px solid #404040;
    border-radius: 4px;
}

/* Dedicated clean styling for the Groups + / - buttons */
#btnAddGroup, #btnRemoveGroup {
    background-color: #2d2d30;
    border: 1px solid #434346;
    border-radius: 3px;
    color: #f0f0f0;
    font-size: 9pt;
    font-weight: bold;
    padding: 0px 0px 2px 0px;
    min-height: 18px;
    min-width: 20px;
}
#btnAddGroup:hover, #btnRemoveGroup:hover {
    background-color: #3e3e42;
    border-color: #0078d7;
}
#btnAddGroup:pressed, #btnRemoveGroup:pressed {
    background-color: #0078d7;
    border-color: #0078d7;
}

/* Dropdown Popup View (applies to every QComboBox popup) */
QComboBox QListView,
QListView#comboPopupView {
    background-color: #1a1a1a;
    color: #ffffff;
    border: 1px solid #383838;
    padding: 1px;
    outline: 0;
    font-family: "Consolas", "Segoe UI", monospace;
    font-size: 11px;
}

QComboBox QListView::item,
QListView#comboPopupView::item {
    height: 19px;
    min-height: 19px;
    padding: 1px 4px;
}

QComboBox QListView::item:hover,
QListView#comboPopupView::item:hover {
    background-color: #2c2c2c;
}

QComboBox QListView::item:selected,
QListView#comboPopupView::item:selected {
    background-color: #3b4252;
    color: #ffffff;
}

/* Checkboxes base layout */
QCheckBox {
    spacing: 5px;
    color: #d0d0d0;
    font-size: 11px;
    background: transparent;
}
QCheckBox::indicator,
QAbstractItemView::indicator,
QTreeWidget::indicator,
QListWidget::indicator,
QTableView::indicator,
QTableWidget::indicator {
    width: 13px;
    height: 13px;
}

QSplitter::handle {
    background-color: #38383c;
}
QSplitter::handle:hover {
    background-color: #0078d7;
}
QSplitter::handle:horizontal {
    width: 2px;
}
QSplitter::handle:vertical {
    height: 2px;
}

/* Slim Scrollbars inside dropdowns and views */
QScrollBar:vertical {
    border: none;
    background-color: #141414;
    width: 8px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background-color: #3e3e3e;
    min-height: 20px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background-color: #4e4e4e;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background-color: #141414;
    height: 8px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background-color: #3e3e3e;
    min-width: 20px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #4e4e4e;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

QStatusBar {
    background-color: #202022;
    color: #f0f0f0;
    border-top: 1px solid #38383c;
    min-height: 22px;
    max-height: 22px;
}
