/* Windows Forms 1:1 Clean Light Theme with PointerFinder2 Polished Accents */

/* Base font for closed QComboBox and general UI */
QWidget {
    font-family: "Segoe UI", "Inter", "Helvetica Neue", sans-serif;
}

QMainWindow {
    background-color: #f0f0f0;
    color: #000000;
}

QDialog {
    background-color: #f5f5f5;
    color: #2b2b2b;
}

/* Tooltips */
QToolTip {
    background-color: #f8f8f8;
    color: #202020;
    border: 1px solid #c8c8c8;
    border-radius: 3px;
    padding: 2px 4px;
    font-size: 11px;
    margin: 0px;
}

/* QTabWidget Pane & Styling matching Pointer Finder 2.0 Settings */
QTabWidget::pane {
    border: 1px solid #d0d0d0;
    background-color: #f5f5f5;
    top: -1px;
}
QTabWidget::tab-bar {
    left: 4px;
}
QTabBar::tab {
    background-color: #e0e0e0;
    color: #4a4a4a;
    border: 1px solid #d0d0d0;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 5px 12px;
    margin-right: 2px;
    font-size: 11px;
}
QTabBar::tab:hover {
    background-color: #dadada;
    color: #1e1e1e;
}
QTabBar::tab:selected {
    background-color: #f5f5f5;
    color: #1e1e1e;
    border-bottom: 1px solid #f5f5f5;
    font-weight: bold;
}

/* Group Boxes matching Pointer Finder 2.0 */
QGroupBox {
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    margin-top: 8px;
    font-size: 11px;
    font-weight: bold;
    color: #4a4a4a;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 3px;
}

/* Data Tables - Background #8c8c8c represents the WinForms DataGridView AppWorkspace backdrop */
QTableView, QTableWidget {
    background-color: #8c8c8c;
    color: #000000;
    border: 1px solid #707070;
    gridline-color: #707070;
    selection-background-color: #0078d7;
    selection-color: #ffffff;
    outline: 0;
}

/* Dialogs: Data Tables have clean white backgrounds matching WinForms dialogs */
QDialog QTableView, QDialog QTableWidget {
    background-color: #ffffff;
    color: #000000;
    border: 1px solid #707070;
    gridline-color: #d0d0d0;
    selection-background-color: #0078d7;
    selection-color: #ffffff;
    outline: 0;
}

/* MultiRegionDialog tables maintain consistent #8c8c8c workspace background when empty */
#dgvMapping, #gridLockLogic {
    background-color: #8c8c8c;
    gridline-color: #707070;
}

QTreeWidget, QListWidget {
    background-color: #ffffff;
    color: #000000;
    border: 1px solid #a0a0a0;
    gridline-color: #707070;
    selection-background-color: #0078d7;
    selection-color: #ffffff;
    outline: 0;
}

QTreeWidget::item, QListWidget::item {
    min-height: 18px;
}

#groupsList {
    border-top: none;
    padding-top: 2px;
}

#groupsList::item {
    min-height: 20px;
    padding: 1px 2px;
}

#lblStrideHint, #lblHint, #lblInstruction, #lblInfo {
    color: #707070;
}

#lblOffsetChain, #lblAuthor {
    color: #707070;
}

#lblAssetState {
    color: #707070;
    font-style: italic;
}

#lblAssetState[assetState="local"] {
    color: #2e8b57;
    font-style: italic;
}

#pbBadge {
    border: 1px solid #adadad;
    background-color: #e0e0e0;
}

QLabel#strideHexLabel {
    color: #0969da;
    font-weight: bold;
    font-family: "Consolas", monospace;
}

QLabel#subTextDescLabel {
    color: #666666;
    font-size: 11px;
}

QLabel#settingsHelpTitleLabel {
    font-size: 13px;
    font-weight: bold;
    color: #1e1e1e;
}

/* Crisp left-aligned DataGridView headers with selective blue highlight on active selection */
QHeaderView::section {
    background-color: #f0f0f0;
    color: #000000;
    border: 1px solid #707070;
    border-top: none;
    border-left: none;
    padding: 3px 5px;
    font-weight: normal;
    text-align: left;
}
QHeaderView::section:checked, QHeaderView::section:selected {
    background-color: #cce4f7;
    color: #000000;
    border: 1px solid #707070;
    border-top: none;
    border-left: none;
}
QTableView QTableCornerButton::section {
    background-color: #f0f0f0;
    border: 1px solid #707070;
}

#lblGroupsHeader {
    background-color: #f0f0f0;
    border: 1px solid #707070;
    color: #000000;
}

/* Inputs & Edit Controls */
QLineEdit {
    border: 1px solid #adadad;
    border-radius: 2px;
    background-color: #ffffff;
    color: #000000;
    padding: 2px 3px;
    selection-background-color: #0078d7;
    selection-color: #ffffff;
}
QLineEdit:focus {
    border-color: #0078d7;
}
QLineEdit[feedbackState="fail"] {
    background-color: #ffecec;
    border-color: #d32f2f;
}
QLineEdit[feedbackState="warn"] {
    background-color: #fff9db;
    border-color: #e6a100;
}
QLineEdit[feedbackState="info"] {
    background-color: #eef6ff;
    border-color: #3a78cb;
}

QDialog QLineEdit {
    background-color: #ffffff;
    color: #2b2b2b;
    border: 1px solid #c0c0c0;
    border-radius: 3px;
    padding: 3px 5px;
    font-size: 11px;
}
QDialog QLineEdit:focus {
    border-color: #0078d7;
}

QPlainTextEdit, QTextEdit {
    font-family: "Consolas", "JetBrains Mono", "Courier New", monospace;
    font-size: 11px;
    background-color: #ffffff;
    color: #2b2b2b;
    border: 1px solid #c0c0c0;
    border-radius: 3px;
}
QPlainTextEdit:focus, QTextEdit:focus {
    border-color: #0078d7;
}

#txtNoteBody {
    font-family: "Consolas", "Courier New", monospace;
    font-size: 10pt;
}

/* Buttons */
QPushButton {
    border: 1px solid #adadad;
    border-radius: 2px;
    background-color: #f6f6f6;
    color: #000000;
    padding: 0px 4px 2px 4px;
    min-height: 16px;
    text-align: center;
}
QPushButton:hover {
    background-color: #e5f1fb;
    border-color: #0078d7;
}
QPushButton:pressed {
    background-color: #cce4f7;
    border-color: #005499;
}
QPushButton:disabled {
    background-color: #f4f4f4;
    color: #8a8a8a;
    border-color: #dcdcdc;
}

/* Dedicated compact button sizing matching PF2 */
QPushButton#okButton,
QPushButton#cancelButton,
QPushButton#closeButton {
    min-width: 56px;
    max-width: 56px;
    height: 17px;
    padding: 2px 8px;
    font-size: 11px;
}

QPushButton#updateNowButton {
    font-weight: bold;
    padding: 2px 12px;
}

QPushButton#resetAllButton {
    color: #d32f2f;
    font-weight: bold;
    padding: 4px;
    border: 1px solid #c0c0c0;
    border-radius: 4px;
}

/* Dedicated clean styling for the Groups + / - buttons matching WinForms Screenshot 3 */
#btnAddGroup, #btnRemoveGroup {
    background-color: #ffffff;
    border: 1px solid #c8c8c8;
    border-radius: 3px;
    color: #000000;
    font-size: 9pt;
    font-weight: bold;
    padding: 0px 0px 2px 0px;
    min-height: 18px;
    min-width: 20px;
}
#btnAddGroup:hover, #btnRemoveGroup:hover {
    background-color: #f0f7fd;
    border-color: #0078d7;
}
#btnAddGroup:pressed, #btnRemoveGroup:pressed {
    background-color: #cce4f7;
    border-color: #005499;
}

/* Dropdown Popup View (applies to every QComboBox popup) */
QComboBox QListView,
QListView#comboPopupView {
    background-color: #ffffff;
    color: #000000;
    border: 1px solid #c0c0c0;
    padding: 1px;
    outline: 0;
    font-family: "Consolas", "Segoe UI", monospace;
    font-size: 11px;
}

QComboBox QListView::item,
QListView#comboPopupView::item {
    height: 19px;
    min-height: 19px;
    padding: 1px 4px;
}

QComboBox QListView::item:hover,
QListView#comboPopupView::item:hover {
    background-color: #e5f1fb;
    color: #000000;
}

QComboBox QListView::item:selected,
QListView#comboPopupView::item:selected {
    background-color: #3a78cb;
    color: #ffffff;
}

/* Checkboxes base layout */
QCheckBox {
    spacing: 5px;
    color: #333333;
    font-size: 11px;
    background: transparent;
}
QCheckBox::indicator,
QAbstractItemView::indicator,
QTreeWidget::indicator,
QListWidget::indicator,
QTableView::indicator,
QTableWidget::indicator {
    width: 13px;
    height: 13px;
}

/* Splitters */
QSplitter::handle {
    background-color: #d0d0d0;
}
QSplitter::handle:hover {
    background-color: #0078d7;
}
QSplitter::handle:horizontal {
    width: 2px;
}
QSplitter::handle:vertical {
    height: 2px;
}

/* Slim Scrollbars inside dropdowns and views */
QScrollBar:vertical {
    border: none;
    background-color: #f0f0f0;
    width: 8px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background-color: #c0c0c0;
    min-height: 20px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background-color: #a0a0a0;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background-color: #f0f0f0;
    height: 8px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background-color: #c0c0c0;
    min-width: 20px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #a0a0a0;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* Status Bar */
QStatusBar {
    background-color: #f0f0f0;
    color: #000000;
    border-top: 1px solid #d0d0d0;
    min-height: 22px;
    max-height: 22px;
}
