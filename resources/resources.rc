#include <windows.h>

IDI_ICON1 ICON "appicon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     RC_VERSION_MAJOR,RC_VERSION_MINOR,RC_VERSION_PATCH,RC_VERSION_BUILD
PRODUCTVERSION  RC_VERSION_MAJOR,RC_VERSION_MINOR,RC_VERSION_PATCH,RC_VERSION_BUILD
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "RetroAchievements"
            VALUE "FileDescription",  "RA Logic Editor"
            VALUE "FileVersion",      RC_VERSION_STRING
            VALUE "InternalName",     "RALogicEditor"
            VALUE "LegalCopyright",   "Copyright (C)"
            VALUE "OriginalFilename", "RALogicEditor.exe"
            VALUE "ProductName",      "RA Logic Editor"
            VALUE "ProductVersion",   VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
